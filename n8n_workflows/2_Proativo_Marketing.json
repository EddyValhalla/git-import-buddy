{
  "name": "2_Proativo_Marketing",
  "nodes": [
    {
      "id": "d3a669b6-8a5e-43fb-a9cc-acaad103ea12",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "72c2285c-102d-4b08-9d39-6a1701a88b8e",
      "name": "Buscar Carrinhos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        250,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM carrinho WHERE status IN ('PENSANDO', 'AGUARDANDO') AND (proxima_mensagem_em IS NULL OR proxima_mensagem_em <= now()) ORDER BY criado_em ASC;"
      },
      "credentials": {
        "postgres": {
          "id": "SELECIONE",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "a902da62-9309-46cf-8ada-d52f9470b07d",
      "name": "Buscar Lembretes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        250,
        150
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.cliente_id, a.data_hora_inicio, a.procedimento_nome, c.nome AS cliente_nome, c.telefone AS cliente_telefone FROM agendamentos a JOIN clientes c ON c.id = a.cliente_id WHERE a.data_hora_inicio BETWEEN now() + interval '20 hours' AND now() + interval '28 hours' AND a.confirmado = false AND a.lembrete_enviado = false;"
      },
      "credentials": {
        "postgres": {
          "id": "SELECIONE",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "2eadc582-f51c-440f-8d71-ed750ad53d76",
      "name": "Split In Batches (Carrinho)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        500,
        -100
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "1b112b29-9cca-40ec-b407-7b421a3a72f7",
      "name": "Chamar Upsell",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
