      }
    },
    {
      "id": "95e577d8-9649-4bd8-89ea-f4466288fcc4",
      "name": "Atualizar Carrinho",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1000,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE carrinho SET mensagens_enviadas = mensagens_enviadas + 1, ultima_mensagem_em = now(), proxima_mensagem_em = now() + (intervalo_recaptura_dias || ' days')::interval, status = COALESCE('{{ $json.novo_status }}', status) WHERE id = '{{ $json.carrinho_id }}';"
      },
      "credentials": {
        "postgres": {
          "id": "SELECIONE",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "7cecccaa-835d-43c7-8dd3-4cca6a2f28be",
      "name": "Log Mensagem",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1250,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO envio_mensagens (id, template_ref, mensagem_texto, cliente_id, carrinho_id, canal, enviado_em) VALUES (gen_random_uuid(), 'CARRINHO_REC', '{{ $json.mensagem_whatsapp }}', '{{ $json.cliente_id }}', '{{ $json.carrinho_id }}', 'whatsapp', now());"
      },
      "credentials": {
        "postgres": {
          "id": "SELECIONE",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "86d9df8e-b197-43ef-ab98-22d9c42b34c2",
      "name": "Enviar Lembrete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        150
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sua-evolution/message/sendText/Instancia",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"number\": \"55{{ $json.cliente_telefone }}\",\n  \"textMessage\": {\n    \"text\": \"Olá {{ $json.cliente_nome.split(' ')[0] }}! Passando para lembrar do seu horário amanhã às {{ new Date($json.data_hora_inicio).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) }} para {{ $json.procedimento_nome }}.\\n\\nVocê confirma sua presença?\\nResponda *SIM* para confirmar ou *PRECISO REMARCAR*.\"\n  }\n}"
      },
      "credentials": {
        "evolutionApi": {
          "id": "SELECIONE",
          "name": "Evolution API"
        }
      }
    },
    {
      "id": "0404ddb1-7fe0-4a1c-b024-34cc4f4dd092",
      "name": "Atualizar Agendamento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agendamentos SET lembrete_enviado = true, lembrete_enviado_em = now() WHERE id = '{{ $(\"Buscar Lembretes\").item.json.id }}';"
      },
      "credentials": {
        "postgres": {
          "id": "SELECIONE",
          "name": "Postgres account"
        }
      }
    }
